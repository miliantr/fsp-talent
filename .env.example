# Copy to .env and adjust. All variables are optional — defaults work out of the box.

# --- PostgreSQL (docker-compose) ---
POSTGRES_DB=fsp_talent
POSTGRES_USER=fsp
POSTGRES_PASSWORD=fsp_password

# --- Backend ---
# For local runs without docker the backend uses SQLite (backend/fsp_talent.db) when DATABASE_URL is not set.
# DATABASE_URL=postgresql+psycopg://fsp:fsp_password@localhost:5432/fsp_talent
JWT_SECRET=change-me-in-production-please-32b+
ACCESS_TOKEN_TTL_MINUTES=720

# Demo mode: the e-mail confirmation code is returned by the API and shown in the UI.
# Set to false in production (codes are then only delivered by e-mail / Mailpit).
EMAIL_DEV_EXPOSE_CODE=true
# SMTP_HOST=mailpit
# SMTP_PORT=1025

# Testing engine
TEST_LENGTH=20
TEST_TIME_LIMIT_MINUTES=30
RETAKE_COOLDOWN_DAYS=30
GRADE_CHANGE_COOLDOWN_DAYS=90
# verified categories per candidate (one per specialization)
MAX_CATEGORIES=3

# Regular tasks: at most one new addressed task per candidate per N days; background pass (0 = on demand only)
TASK_OFFER_INTERVAL_DAYS=7
TASK_OFFER_LOOP_MINUTES=60

# Invitations
INVITATION_TTL_DAYS=14
INVITATIONS_DAILY_LIMIT=40

# FSP registry integration: mock (in-process synthetic registry) | http (REST adapter)
FSP_REGISTRY_MODE=mock
FSP_REGISTRY_URL=http://localhost:8000/api/mock-fsp/v1

# Optional override of matching weights, e.g. {"skills": 0.3, "fsp": 0.15}
# MATCHING_WEIGHTS_JSON=
